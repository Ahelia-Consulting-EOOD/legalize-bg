   "/api/v1/laws/{slug}": {
    "get": {
     "summary": "Get Law",
     "operationId": "get_law_api_v1_laws__slug__get",
     "parameters": [
      {
       "name": "slug",
       "in": "path",
       "required": true,
       "schema": {
        "type": "string",
