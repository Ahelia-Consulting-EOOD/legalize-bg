  "paths": {
    "/api/v1/laws": {
      "get": {
        "operationId": "list_laws_api_v1_laws_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "estado",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LawListResponseDict"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`INDEX_MISSING` — catalog.db is missing tables/columns or unreadable at query time"
          }
        },
        "summary": "List Laws"
      }
    },
    "/api/v1/laws/{slug}": {
      "get": {
        "operationId": "get_law_api_v1_laws__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLawResponseDict"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`INVALID_DATE` — a `date`-like parameter is missing or not a valid YYYY-MM-DD string"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`LAW_NOT_FOUND` — no act matches the given slug, identificador, or title; `NO_VERSION_AT_DATE` — the requested date precedes the act's earliest recorded version, or it has none"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`AMBIGUOUS_NAME` — multiple acts share the given title"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`INDEX_STALE` — the catalog and corpus have diverged for this act; `INDEX_MISSING` — catalog.db is missing tables/columns or unreadable at query time"
          }
        },
        "summary": "Get Law"
      }
    },
    "/api/v1/laws/{slug}/articles/{art}": {
      "get": {
        "operationId": "get_article_api_v1_laws__slug__articles__art__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "art",
            "required": true,
            "schema": {
              "title": "Art",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResponseDict"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`INVALID_DATE` — a `date`-like parameter is missing or not a valid YYYY-MM-DD string; `INVALID_ARTICLE_SPEC` — the article spec could not be parsed, or a range (`чл. 5-7`) was given where only a single article is accepted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`LAW_NOT_FOUND` — no act matches the given slug, identificador, or title; `NO_VERSION_AT_DATE` — the requested date precedes the act's earliest recorded version, or it has none; `ARTICLE_NOT_FOUND` — the article/alinea spec parsed but no provisions row matches it"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`AMBIGUOUS_NAME` — multiple acts share the given title"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDict"
                }
              }
            },
            "description": "`INDEX_MISSING` — catalog.db is missing tables/columns or unreadable at query time"
          }
        },
        "summary": "Get Article"
      }
    },
    "/api/v1/laws/{slug}/diff": {
